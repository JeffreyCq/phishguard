# ─── ML Classifier (DistilBERT) ──────────────────────────────────────────────
# Model is downloaded automatically from HuggingFace on first start.
# Only set HF_TOKEN if the repo is private.
HF_MODEL_REPO=jeffreycq/maildefender-distilbert
HF_TOKEN=

# ─── Local AI (Ollama) ────────────────────────────────────────────────────────
# Model to use for phishing analysis. qwen2.5:3b is pulled automatically on
# first startup (~2 GB download). Change to any Ollama-supported model tag.
OLLAMA_MODEL=qwen2.5:3b
# Set automatically by docker-compose; override here only if running without Docker
# OLLAMA_BASE_URL=http://ollama:11434

# ─── Threat Intelligence APIs (optional — features degrade gracefully) ────────
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=

# ─── Public REST API ─────────────────────────────────────────────────────────
# Enables the /api/v1/scan endpoint. Generate any random secret, e.g.:
#   openssl rand -hex 32
PUBLIC_API_KEY=

# ─── Email Forwarding (optional) ─────────────────────────────────────────────
# If set, an SMTP server starts on SMTP_LISTEN_PORT (default 2525).
# Users can forward suspicious emails to SMTP_FROM — they get an HTML reply.
#
# Recommended free provider: Resend (resend.com) — 3 000 emails/month free
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_your_resend_api_key
#   SMTP_FROM=scan@yourdomain.com
#
# Alternative: Brevo (brevo.com) — 300 emails/day free, no custom domain needed

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=scan@yourdomain.com
SMTP_USE_TLS=true

# Internal listener — leave as-is unless port 2525 is taken on your host
SMTP_LISTEN_PORT=2525
SMTP_LISTEN_HOST=0.0.0.0
